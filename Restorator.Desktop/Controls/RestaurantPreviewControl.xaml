<UserControl x:Class="Restorator.Desktop.Controls.RestaurantPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Restorator.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:RestaurantPreviewViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Viewbox>
        <StackPanel>
            <ui:TextBlock Text="{Binding Name}" FontTypography="Subtitle" />
            <ui:TextBlock Text="{Binding Description}" FontTypography="Body" TextWrapping="Wrap" />

            <ui:TextBlock Text="Время работы"/>
            <ui:TextBlock>
                <ui:TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} - {1}">
                        <Binding Path="BeginWorkTime" StringFormat="hh:mm" />
                        <Binding Path="EndWorkTime" StringFormat="hh:mm" />
                    </MultiBinding>
                </ui:TextBlock.Text>
            </ui:TextBlock>

        </StackPanel>
    </Viewbox>
</UserControl>
