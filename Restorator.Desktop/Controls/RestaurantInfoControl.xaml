<UserControl x:Class="Restorator.Desktop.Controls.RestaurantInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Restorator.Desktop.ViewModels"
             xmlns:pages="clr-namespace:Restorator.Desktop.Views.Pages"
             d:DataContext="{d:DesignInstance Type=viewmodels:RestaurantInfoViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ui:DynamicScrollViewer>
        <StackPanel>
            <ui:TextBlock Text="{Binding Name}" FontTypography="Display"/>

            <ui:TextBlock Text="{Binding Description}" FontTypography="Title" FontWeight="Normal" TextWrapping="Wrap" Margin="0,20,0,20"/>
            <DockPanel>
                <StackPanel>
                    <ui:TextBlock Text="Время работы" FontTypography="Title"/>

                    <ui:TextBlock FontTypography="Title" FontWeight="Normal">
                        <ui:TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} - {1}">
                                <Binding Path="BeginWorkTime" StringFormat="t" />
                                <Binding Path="EndWorkTime" StringFormat="t" />
                            </MultiBinding>
                        </ui:TextBlock.Text>
                    </ui:TextBlock>
                </StackPanel>

                <ui:Button Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type pages:RestaurantSearchPage}}, Path=DataContext.OpenRestaurantReservationCommand}"
                           Appearance="Primary" HorizontalAlignment="Right">
                    <ui:TextBlock Text="Забронировать" FontTypography="Subtitle"/>
                </ui:Button>
            </DockPanel>
        </StackPanel>
    </ui:DynamicScrollViewer>
</UserControl>
