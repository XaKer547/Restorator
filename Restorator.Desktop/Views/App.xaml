<Application x:Class="Restorator.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Restorator.Desktop.Controls"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BitmapImage x:Key="NoImage" UriSource="pack://application:,,,/Resources/NoImage.png"/>

            <Style x:Key="TableButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="border" Background="Transparent">
                                <Path x:Name="MainPart" Stretch="Fill" Fill="Transparent "
                                      Data="M0.201172 177.037L10.1478 182.05H171.561L181.507 177.037V5.74358L171.561 0.743591L10.1478 0.743591L0.201172 5.74358V177.037Z"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="MainPart" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" >
                                        <Setter.Value>
                                            <SolidColorBrush Color="White" Opacity="0.25"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>

                                <DataTrigger Binding="{Binding State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Value="OccupiedByUser">
                                    <Setter TargetName="MainPart" Property="Fill" Value="#1dde27" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Value="Avaible">
                                    <Setter TargetName="MainPart" Property="Fill" Value="Transparent" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Value="OccupiedByOther">
                                    <Setter TargetName="MainPart" Property="Fill" Value="Red" />
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type controls:TimePicker}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:TimePicker}">
                            <StackPanel>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel>
                                            <Button x:Name="HourUpButton" Content="▲" Margin="2"/>
                                            <Border x:Name="HourBorder">
                                                <TextBlock Text="{Binding Hour, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" MinWidth="30"/>
                                            </Border>
                                            <Button x:Name="HourDownButton" Content="▼" Margin="2"/>
                                        </StackPanel>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text=":" TextAlignment="Center" MinWidth="10" />
                                        </StackPanel>

                                        <StackPanel>
                                            <Button x:Name="MinuteUpButton" Content="▲" Margin="2"/>
                                            <Border x:Name="MinuteBorder">
                                                <TextBlock Text="{Binding Minute, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" MinWidth="30"/>
                                            </Border>
                                            <Button x:Name="MinuteDownButton" Content="▼" Margin="2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type controls:SliderTimePicker}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:SliderTimePicker}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="PART_Slider"
                                            Minimum="0" Maximum="86399"
                                            Width="200"
                                            TickFrequency="3600"
                                            IsSnapToTickEnabled="True"
                                            HorizontalAlignment="Left"
                                            TickPlacement="BottomRight"/>
                                    <TextBlock x:Name="PART_TimeText" Margin="10,0,0,0" VerticalAlignment="Center" Text="12:00"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
