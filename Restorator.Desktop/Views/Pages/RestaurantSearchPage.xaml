<Page x:Class="Restorator.Desktop.Views.Pages.RestaurantSearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodels="clr-namespace:Restorator.Desktop.ViewModels"
      xmlns:windows="clr-namespace:Restorator.Desktop.Views.Windows"
      d:DataContext="{d:DesignInstance Type=viewmodels:RestaurantSearchViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <!--SuggestionChosen="" TextChanged=""-->
            <ui:AutoSuggestBox PlaceholderText="Введите название ресторана" OriginalItemsSource="{Binding RestaurantNames}" >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Loaded">
                        <i:InvokeCommandAction Command="{Binding SearchRestaurantsCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ui:AutoSuggestBox>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="itemsPart"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <ui:NavigationView x:Name="navigation" Grid.ColumnSpan="2"
                               CompactPaneLength="{Binding ElementName=itemsPart, Path=ActualWidth, UpdateSourceTrigger=PropertyChanged}">
                <ui:NavigationView.MenuItems>
                    <DockPanel>
                        <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                         ItemsSource="{Binding RestaurantsPreview}" 
                         SelectedItem="{Binding SelectedRestaurantPreview}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ui:TextBlock Text="{Binding Name}" FontTypography="Subtitle" />
                                        <ui:TextBlock Text="{Binding Description}" FontTypography="Body" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding OpenRestaurantInfoCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ListBox>
                    </DockPanel>
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem
                    Content="Выйти"
                    Icon="{ui:SymbolIcon DoorArrowLeft20}"
                    Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:MainWindow}}, Path=DataContext.NavigateToAuthenticationCommand}"/>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>
        </Grid>
    </Grid>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding SearchRestaurantsCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Page>
